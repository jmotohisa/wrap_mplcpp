# checks for python
##############################################################################

AC_ARG_WITH(python,
        [AS_HELP_STRING([--without-python],[compile without Python interface])],
        with_python=$withval,with_python=yes)

AC_CHECK_PROG(SWIG, swig, swig, echo)
if test "$USE_MAINTAINER_MODE" = yes && (test "x$with_python" = "xyes" || test "x$with_scheme" = "xyes") && test "x$SWIG" = xecho; then
  AC_MSG_ERROR([SWIG not found; configure --without-python --without-scheme or use a release tarball])
fi

AC_ARG_WITH(coverage, [AS_HELP_STRING([--with-coverage],[enable Python coverage tests])],
            with_coverage=$withval, with_coverage=no)

if test "x$with_python" = xno; then
  have_python=no
else
  if test "x$have_libctlgeom" = xno; then
    AC_MSG_ERROR([libctlgeom was not found, is required for Python interface])
  fi

  if test "$enable_shared" = no; then
     AC_MSG_WARN([Python interface requires --enable-shared; disabling])
     have_python=no
  else

    AM_PATH_PYTHON([],[have_python=yes],[have_python=no])
    if test $have_python = yes; then
      AC_MSG_CHECKING([for Python library flags])
      py_libdir=`$PYTHON -c "import sysconfig; print(sysconfig.get_config_var('LIBDIR') or '')" 2>/dev/null`
      py_libname=`$PYTHON -c "import sysconfig, re; print(re.sub(r'^lib|\.(so|dylib|a).*$', '', sysconfig.get_config_var('LDLIBRARY') or ''))" 2>/dev/null`
      if test -n "$py_libdir" && test -n "$py_libname"; then
        PYTHON_LIBS="-L$py_libdir -Wl,-rpath,$py_libdir -l$py_libname"
      elif test -n "$py_libdir"; then
        PYTHON_LIBS="-L$py_libdir"
      fi
      AC_MSG_RESULT([${PYTHON_LIBS:-unknown}])

      save_LDFLAGS=$LDFLAGS
      LDFLAGS="$LDFLAGS $PYTHON_LIBS"

      AC_MSG_CHECKING([for Python include directory])
      pinc=`$PYTHON -c "import sysconfig; print(sysconfig.get_path('include'))" 2>/dev/null`
      AC_MSG_RESULT([${pinc:-unknown}])
      test -n "$pinc" && PYTHON_INCLUDES="-I$pinc"
      save_CPPFLAGS=$CPPFLAGS
      CPPFLAGS="$CPPFLAGS $PYTHON_INCLUDES"
      AC_CHECK_HEADER([Python.h], [], [AC_MSG_WARN([disabling Python wrappers])
                                       have_python=no])

      if test $have_python = yes; then
        AC_MSG_CHECKING([for Numpy include directory])
        pinc=`$PYTHON -c "import numpy; print(numpy.get_include())" 2>/dev/null`
        AC_MSG_RESULT([${pinc:-unknown}])
        test -n "$pinc" && PYTHON_INCLUDES="$PYTHON_INCLUDES -I$pinc"
        CPPFLAGS="$save_CPPFLAGS $PYTHON_INCLUDES"
        AC_CHECK_HEADER([numpy/arrayobject.h],[],[
          AC_MSG_WARN([disabling Python wrappers])
          have_python=no],[#include <Python.h>])

        if test x"$with_coverage" = xyes; then
          AC_MSG_CHECKING([for coverage module])
          $PYTHON -c 'import coverage' 2>/dev/null
          if test $? = 0; then
            AC_MSG_RESULT([yes])
          else
            AC_MSG_RESULT([no])
            with_coverage=no
          fi
        fi
      fi
      CPPFLAGS=$save_CPPFLAGS
      LDFLAGS=$save_LDFLAGS

#########
###################################################
# check for libwrapmplcpp 
# --with-wrapmplcpp / --without-wrapmplcpp オプションの定義（デフォルトは auto）
AC_ARG_WITH([wrapmplcpp],
  [AS_HELP_STRING([--with-wrapmplcpp], [use libwrapmplcpp (default: auto)])],
  [with_wrapmplcpp=$withval],
  [with_wrapmplcpp=auto])

have_wrapmplcpp=no
if test "x$with_wrapmplcpp" != "xno"; then
  PKG_CHECK_MODULES([LIBWRAPMPLCPP], [libwrapmplcpp], [
    have_wrapmplcpp=yes
  ], [
    if test "x$with_wrapmplcpp" = "xyes"; then
      # 明示的に --with-wrapmplcpp が指定されたのに見つからない場合はエラーで停止
      AC_MSG_ERROR([--with-wrapmplcpp was given, but libwrapmplcpp was not found via pkg-config])
    else
      # auto の場合は見つからなくても続行する
      AC_MSG_WARN([libwrapmplcpp not found; building without libwrapmplcpp support])
    fi
  ])
fi

# Cソース側で #ifdef HAVE_WRAPMPLCPP を使えるように定義
if test "x$have_wrapmplcpp" = "xyes"; then
  AC_DEFINE([HAVE_WRAPMPLCPP], [1], [Define to 1 if you have libwrapmplcpp.])
fi

# Makefile.am 側で if WITH_WRAPMPLCPP を使えるように定義
AM_CONDITIONAL([WITH_WRAPMPLCPP], [test "x$have_wrapmplcpp" = "xyes"])

# check for libwrapmplcpp end
###################################################
#########
    fi # have_python

  fi # enabled_shared
fi # with_python

if test x"$have_python" = "xyes"; then
   AC_DEFINE(HAVE_PYTHON, 1, [define if we have PYTHON])
fi

AC_SUBST(PYTHON_INCLUDES)
AC_SUBST(PYTHON_LIBS)

AM_CONDITIONAL(WITH_PYTHON, test x"$have_python" = "xyes")
AM_CONDITIONAL(WITH_COVERAGE, test x"$with_coverage" = "xyes")

